# Database
DATABASE_URL=sqlite:///./data/discovery.db

# Raw document storage (local filesystem)
RAW_DATA_DIR=./data/raw

# Embeddings — local model by default (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Set USE_OPENAI_EMBEDDINGS=true to use OpenAI instead
USE_OPENAI_EMBEDDINGS=false

# LLM (optional — pipeline works with rule-based fallbacks)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USE_LLM=true

# Reddit ingestion (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SwiggyDiscoveryBot/1.0

# Apify for app store scraping (optional)

 
APIFY_API_TOKEN=

# Pipeline settings
MIN_EVIDENCE_PER_INSIGHT=3
RAG_TOP_K=20
CLUSTER_MIN_SIZE=5
